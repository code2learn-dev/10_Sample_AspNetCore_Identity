@page "{id?}"
@model Identity.WebAppRazorPage.Areas.Admin.Pages.Users.EditPasswordModel
@{
}
@section styles {
	<link href="~/lib/course-style.css" rel="stylesheet" />
}
<htext>تغییر رمز عبور</htext>
<form asp-page="EditPassword" method="post">
	<input type="hidden" asp-for="PasswordModel.Id">
	<input type="hidden" asp-for="PasswordModel.Image">
	<input type="hidden" asp-for="PasswordModel.UserImageUrl" id="user-image">
	<section class="row">
		<aside class="col-md-3">
			<section class="image-container">
				<img src="" />
				<p class="text-center" id="image-text">تصویری انتخاب نشده است</p>
			</section>
		</aside>
		<aside class="col-md-9">
			<section class="mt-2">
				<label asp-for="PasswordModel.FirstName"></label>
				<input asp-for="PasswordModel.FirstName" class="form-control" disabled="disabled" />
			</section>
			<section class="mt-2">
				<label asp-for="PasswordModel.LastName"></label>
				<input asp-for="PasswordModel.LastName" class="form-control" disabled="disabled" />
			</section>
			<section class="mt-2">
				<label asp-for="PasswordModel.UserName"></label>
				<input asp-for="PasswordModel.UserName" class="form-control" disabled="disabled" />
			</section>
			<section class="mt-2">
				<label asp-for="PasswordModel.RoleId"></label>
				<select asp-for="PasswordModel.RoleId"
						asp-items="@Model.PasswordModel.RoleSelectListItem"
						class="form-control" disabled="disabled">
					<option selected="selected" disabled="disabled">انتخاب نقش کاربر</option>
				</select>
				<span asp-validation-for="PasswordModel.RoleId" class="text-danger"></span>
			</section>
			<section class="mt-2">
				<label asp-for="PasswordModel.NewPassword"></label>
				<input asp-for="PasswordModel.NewPassword" class="form-control" />
				<span asp-validation-for="PasswordModel.NewPassword" class="text-danger"></span>
			</section>
			<section class="mt-2">
				<label asp-for="PasswordModel.ConfirmPassword"></label>
				<input asp-for="PasswordModel.ConfirmPassword" class="form-control" />
				<span asp-validation-for="PasswordModel.ConfirmPassword" class="text-danger"></span>
			</section>
			<formlink link-title="کاربرها" page="Users"></formlink>
		</aside>
	</section>
</form>
@section scripts {
	<script type="text/javascript">
		const image = document.querySelector('img');
		const imageUrl = document.getElementById('user-image');
		const imageText = document.querySelector('p');
		 
		if (imageUrl !== null && imageUrl.value !== undefined) {
			image.setAttribute('src', imageUrl.value);
			image.style.display = 'block';
			imageText.style.opacity = '0.0';

			setTimeout(() => {
				image.style.opacity = '1.0';
				imageText.style.displa = 'none';
			}, 400);
		}
	</script>
}