@page "{id?}"
@model Identity.WebAppRazorPage.Areas.Admin.Pages.Users.DeleteModel
@{
}
@section styles {
	<link href="~/lib/course-style.css" rel="stylesheet" />
}
<htext alert="danger">حذف کاربر</htext>
<form asp-page="Delete" method="post">
	<input type="hidden" asp-for="UserModel.Id">
	<input type="hidden" asp-for="UserModel.Image">
	<input type="hidden" asp-for="UserModel.UserImageUrl" id="user-image">
	<section class="row">
		<aside class="col-md-3">
			<section class="image-container">
				<img src="" />
				<p class="text-center" id="image-text">تصویری انتخاب نشده است</p>
			</section> 
		</aside>
		<aside class="col-md-9">
			<section class="row">
				<section class="col-md-6 mt-2">
					<label asp-for="UserModel.FirstName"></label>
					<input asp-for="UserModel.FirstName" class="form-control" disabled="disabled" /> 
				</section>
				<section class="col-md-6 mt-2">
					<label asp-for="UserModel.LastName"></label>
					<input asp-for="UserModel.LastName" class="form-control" disabled="disabled" /> 
				</section>
			</section>
			<section class="mt-2">
				<label asp-for="UserModel.Email"></label>
				<input asp-for="UserModel.Email" class="form-control" disabled="disabled" /> 
			</section>
			<section class="mt-2">
				<label asp-for="UserModel.PhoneNumber"></label>
				<input asp-for="UserModel.PhoneNumber" class="form-control" disabled="disabled" /> 
			</section>
			<section class="mt-2">
				<label asp-for="UserModel.UserName"></label>
				<input asp-for="UserModel.UserName" class="form-control" disabled="disabled" /> 
			</section>
			<section class="mt-2">
				<label asp-for="UserModel.RoleId"></label>
				<select asp-for="UserModel.RoleId"
						asp-items="@Model.UserModel.RoleSelectListItem"
						class="form-control" disabled="disabled">
					<option selected="selected" disabled="disabled">انتخاب نقش کاربر</option>
				</select> 
			</section>
			<formlink link-title="کاربرها" page="Users" btn-title="حذف" btn-color="danger"></formlink>
		</aside>
	</section>
</form>
@section scripts {
	<script type="text/javascript">
		const image = document.querySelector('img');
		const imageUrl = document.getElementById('user-image');
		const imageText = document.querySelector('p');

		if (imageUrl !== null && imageUrl.value !== undefined) {
			image.setAttribute('src', imageUrl.value);
			image.style.display = 'block';
			imageText.style.opacity = '0.0';

			setTimeout(() => {
				image.style.opacity = '1.0';
				imageText.style.displa = 'none';
			}, 400);
		}
	</script>
}