@page "{id?}"
@model Identity.WebAppRazorPage.Areas.Admin.Pages.Roles.EditModel
@{
}
<htext alert="success">ویرایش نقش</htext>
<form asp-page="Edit" method="post">
	<input asp-for="Role.Id" type="hidden" />
	<section class="mt-2">
		<label asp-for="Role.Name"></label>
		<input asp-for="Role.Name" class="form-control" />
		<span asp-validation-for="Role.Name" class="text-danger"></span>
	</section>
	<section class="mt-2">
		<label asp-for="Role.Description"></label>
		<input asp-for="Role.Description" class="form-control" />
		<span asp-validation-for="Role.Description" class="text-danger"></span>
	</section>
	<section class="mt-2">
		<formlink link-title="نقش ها" page="Roles" btn-title="ذخیره تغییرات" btn-color="success"></formlink>
	</section>
</form>