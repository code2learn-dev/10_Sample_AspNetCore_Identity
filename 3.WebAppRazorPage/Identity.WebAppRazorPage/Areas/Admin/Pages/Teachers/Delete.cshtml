@page "{id?}"
@model Identity.WebAppRazorPage.Areas.Admin.Pages.Teachers.DeleteModel
@{
}
@section styles {
	<link href="~/lib/course-style.css" rel="stylesheet" />
}
<htext alert="danger">حذف مدرس</htext>
<form asp-page="Delete" method="post" enctype="multipart/form-data">
	<input asp-for="TeacherModel.Id" type="hidden" />
	<input asp-for="TeacherModel.Image" type="hidden" />
	<input asp-for="TeacherModel.TeacherImageUrl" type="hidden" id="teacher-image" />
	<input value="" type="hidden" id="teacher-image" />
	<section class="row">
		<aside class="col-md-4">
			<section class="image-container">
				<img src="@Model.TeacherModel.TeacherImageUrl" data-action="edit" />
			</section> 
		</aside>
		<aside class="col-md-8">
			<section class="mt-2">
				<label asp-for="TeacherModel.FirstName"></label>
				<input asp-for="TeacherModel.FirstName" class="form-control" disabled="disabled" /> 
			</section>
			<section class="mt-2">
				<label asp-for="TeacherModel.LastName"></label>
				<input asp-for="TeacherModel.LastName" class="form-control" disabled="disabled" /> 
			</section>
			<section class="mt-2">
				<label asp-for="TeacherModel.NationaCode"></label>
				<input asp-for="TeacherModel.NationaCode" class="form-control" disabled="disabled" /> 
			</section>
			<formlink link-title="لیست مدرسین" page="Teachers" btn-color="danger" btn-title="حذف"></formlink>
		</aside>
	</section>
</form>
@section scripts {
	<script>
		const image = document.querySelector('img');
		const action = image.dataset.action;
		if (action !== undefined && action === 'edit') {
			image.style.display = 'block';
			setTimeout(() => {
				image.style.opacity = '1.0';
			}, 400);
		}
	</script>
}
