@page
@model Identity.WebAppRazorPage.Areas.Admin.Pages.Courses.IndexModel
@{
}
<htext>لیست دوره های آموزشی</htext>
<table class="table table-bordered table-striped">
	<thead>
		<tr>
			<td>#</td>
			<td>عنوان محصول</td>
			<td>قیمت</td>
			<td>عملیات</td>
		</tr>
	</thead>
	<tbody>
		@if (Model.Courses.Any())
		{
			foreach (var course in Model.Courses.Index())
			{
				<tr>
					<td>@(course.Index + 1)</td>
					<td>@course.Item.Title</td>
					<td>@($"{course.Item.Price:n0} تومان")</td>
					<td>
						<a asp-page="Edit" asp-route-id="@course.Item.Id" class="btn btn-info btn-sm">ویرایش</a>
						<a asp-page="Delete" asp-route-id="@course.Item.Id" class="btn btn-danger btn-sm">حذف</a>
						<a asp-page="Display" asp-route-id="@course.Item.Id" class="btn btn-warning btn-sm">مشاهده</a>
					</td>
				</tr>
			}
		}
		else
		{
			<tr>
				<td colspan="4">
					<p class="alert alert-warning text-center">دوره آموزشی ثبت نشده است</p>
				</td>
			</tr>
		}
	</tbody>
</table>
<addlink caption="دوره آموزشی جدید" page="Courses"></addlink>
