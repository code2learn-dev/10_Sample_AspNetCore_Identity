@page "{id?}"
@model Identity.WebAppRazorPage.Areas.Admin.Pages.Courses.DeleteModel
@{ 
}
@section styles {
	<link href="~/lib/course-style.css" rel="stylesheet" />
} 
<htext alert="danger">حذف دوره آموزشی</htext>
<form asp-page="Delete" method="post" enctype="multipart/form-data">
	<input asp-for="CourseModel.Image" id="course-image" type="hidden" />
	<input asp-for="@Model.CourseModel.CourseImageUrl" id="course-image-url" type="text" />
	<input asp-for="CourseModel.Id" id="course-image" type="hidden" />
	<section class="row">
		<aside class="col-md-4">
			<section class="image-container">
				<img src="@Model.CourseModel.CourseImageUrl" alt="@Model.CourseModel.Title" />
			</section> 
		</aside>
		<aside class="col-md-8">
			<section class="mt-2">
				<label asp-for="CourseModel.Title"></label>
				<input asp-for="CourseModel.Title" class="form-control" disabled="disabled" />
			</section>
			<section class="mt-2">
				<label asp-for="CourseModel.Price"></label>
				<input asp-for="CourseModel.Price" class="form-control" disabled="disabled" />
			</section>
			<section class="mt-2">
				<label asp-for="CourseModel.CategoryId"></label>
				<select asp-for="CourseModel.CategoryId"
						asp-items="@Model.CourseModel.CategorySelectListItem"
						class="form-select"
						disabled="disabled">
					<option selected="selected" disabled="disabled" value="">انتخاب دسته آموزشی</option>
				</select>
				<span asp-validation-for="CourseModel.CategoryId" class="text-danger"></span>
			</section>
			<section class="mt-2">
				<label asp-for="CourseModel.TeacherId"></label>
				<select asp-for="CourseModel.TeacherId"
						asp-items="@Model.CourseModel.TeacherSelectListItem"
						class="form-select"
						disabled="disabled">
				</select>
			</section>
			<formlink link-title="دوره های آموزشی" page="Courses" btn-title="حذف" btn-color="danger"></formlink>
		</aside>
	</section>
</form>
@section scripts {
	<script>
		const image = document.querySelector('img');
		image.style.display = 'block';
		setTimeout(() => {
			image.style.opacity = '1.0';
		}, 400);
	</script>
}
